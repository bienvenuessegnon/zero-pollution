rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // A helper to verify IDs
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Users collection rules
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true; // In a real production app we'd restrict to request.auth, but here we allow easy local-first client sync
    }

    // 3. Incidents collection rules
    match /incidents/{incidentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Comments collection rules
    match /comments/{commentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
